{
  "name": "szeptucha",
  "version": "0.1.0",
  "private": true,
  "description": "Notatki głosowe i korekta tekstu z AI dla Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && vite build && electron-builder --publish never",
    "build:web": "tsc && vite build",
    "start": "electron .",
    "test": "node --test",
    "pretest:e2e:ocr": "npm run build:web",
    "test:e2e:ocr": "electron scripts/ocr-e2e.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/pol": "1.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "electron": "43.8.3",
    "electron-builder": "26.18.0",
    "lucide-react": "1.66.0",
    "png-to-ico": "3.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "pl.szeptucha.desktop",
    "productName": "Szeptucha",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Szeptucha-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "asarUnpack": [
      "electron/ocr/main/platform/**"
    ]
  }
}
