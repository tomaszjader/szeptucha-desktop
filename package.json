{
  "name": "szeptucha",
  "version": "0.1.0",
  "private": true,
  "description": "Notatki głosowe i korekta tekstu z AI dla Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc && vite build && electron-builder",
    "build:web": "tsc && vite build",
    "start": "electron .",
    "test": "node --test",
    "pretest:e2e:ocr": "npm run build:web",
    "test:e2e:ocr": "electron scripts/ocr-e2e.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/pol": "^1.0.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tesseract.js": "^7.0.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.3",
    "wait-on": "latest"
  },
  "build": {
    "appId": "pl.szeptucha.desktop",
    "productName": "Szeptucha",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Szeptucha-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "asarUnpack": [
      "electron/ocr/main/platform/**"
    ]
  }
}
